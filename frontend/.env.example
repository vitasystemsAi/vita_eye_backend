# Copy to frontend/.env.local for local development. Only NEXT_PUBLIC_* values reach the browser.

FRONTEND_PORT=3001
# Interface for `npm run dev|start`. Keep 127.0.0.1 unless the console must be reachable from other machines.
FRONTEND_HOST=127.0.0.1

# Server-side target of the /api/v1 rewrite (never exposed to the browser)
API_PROXY_TARGET=http://localhost:5000

# Socket.IO endpoint. Leave empty in production (same origin through Nginx).
NEXT_PUBLIC_SOCKET_URL=http://localhost:5000

# Optional Firebase Cloud Messaging web push (public web-app config, not secrets).
# Push stays disabled in the UI until all of these are set and the backend has FCM_ENABLED=true.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
