# VITA EYE edge proxy (rendered by the nginx image's envsubst into /etc/nginx/conf.d/).
# Only this container publishes ports; the backend, AI service, MySQL and Redis stay on the
# private Docker network. TLS certificates are mounted read-only from infra/nginx/certs/.

server_tokens off;

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Edge rate limits (the API applies its own per-account limits as well)
limit_req_zone $binary_remote_addr zone=vita_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=vita_api:10m rate=30r/s;
limit_req_status 429;

upstream vita_backend {
    server backend:5000;
    keepalive 32;
}

upstream vita_frontend {
    server frontend:3001;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name ${NGINX_SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${NGINX_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:VITA_SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Enrollment accepts up to 5 images of 5 MB each
    client_max_body_size 30m;

    proxy_http_version 1.1;
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    # Overwrite (not append) so clients cannot inject addresses; the API trusts exactly one proxy hop
    proxy_set_header X-Forwarded-For   $remote_addr;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host  $host;
    proxy_set_header Connection        "";

    # Service-to-service endpoints (AI service -> backend) are reachable only inside the Docker
    # network. Case-insensitive because Express routing is case-insensitive.
    location ~* ^/api/v1/internal(/|$) {
        return 404;
    }

    location = /api/v1/auth/login {
        limit_req zone=vita_auth burst=5 nodelay;
        proxy_pass http://vita_backend;
    }

    location ~ ^/api/v1/auth/(forgot-password|reset-password)$ {
        limit_req zone=vita_auth burst=5 nodelay;
        proxy_pass http://vita_backend;
    }

    location /api/ {
        limit_req zone=vita_api burst=60 nodelay;
        proxy_pass http://vita_backend;
        proxy_read_timeout 60s;
    }

    location /socket.io/ {
        proxy_pass http://vita_backend;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }

    location / {
        proxy_pass http://vita_frontend;
    }
}
