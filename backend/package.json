{
  "name": "vita-eye-backend",
  "version": "1.0.0",
  "description": "VITA EYE backend API (Express + Sequelize + Socket.IO)",
  "main": "dist/server.js",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:create": "tsx src/db/cli.ts create",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:migrate:undo": "tsx src/db/cli.ts migrate:undo",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:status": "tsx src/db/cli.ts status",
    "db:setup": "tsx src/db/cli.ts create && tsx src/db/cli.ts migrate && tsx src/db/cli.ts seed",
    "keys:generate": "tsx src/db/keys.ts",
    "keys:rewrap": "tsx src/db/rewrap.ts"
  },
  "license": "UNLICENSED",
  "type": "commonjs",
  "dependencies": {
    "argon2": "^0.45.1",
    "bullmq": "^6.3.11",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "jsonwebtoken": "^9.0.3",
    "jszip": "^3.10.2",
    "multer": "^2.4.0",
    "mysql2": "^3.24.5",
    "nodemailer": "^10.0.15",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.1",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.4",
    "umzug": "^3.8.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
